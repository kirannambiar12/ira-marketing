# Copy to `.env` or `.env.development` in the project root (same folder as gatsby-config.ts).
# Gatsby only exposes variables prefixed with GATSBY_ to the browser — use that prefix below.

# Production URL (canonical, OG, sitemap, robots). Required for accurate SEO in builds.
GATSBY_SITE_URL=https://iraluxe.in

# Klaviyo — Public API key / Site ID (Account → Settings → API keys → Public API key)
# https://www.klaviyo.com/
GATSBY_KLAVIYO_PUBLIC_API_KEY=

# Klaviyo — list ID for private-list signups (Lists & segments → list)
GATSBY_KLAVIYO_LIST_ID=

# Optional aliases (mapped to GATSBY_* at build time). Still must not use private API keys in the client.
# KLAVIYO_PUBLIC_API_KEY=
# KLAVIYO_LIST_ID=

# If `npm install` fails on sharp (global libvips), use:
# SHARP_IGNORE_GLOBAL_LIBVIPS=1 npm install
